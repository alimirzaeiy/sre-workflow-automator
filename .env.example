# ==========================================
# Deploy Automation Configuration (.env)
# ==========================================

# ClickUp Configuration
CLICKUP_API_TOKEN=pk_12345678_example_token
CLICKUP_TEAM_ID=1234567
CLICKUP_SRE_SPACE_NAME=SRE
CLICKUP_DEPLOY_FORM_NAME=deploy
CLICKUP_REPO_FIELD_NAME=repo
CLICKUP_WAITING_STATUS=waiting for customer

# GitLab Configuration
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-example_personal_access_token_here
GITLAB_MIN_ACCESS_LEVEL=40

# Telegram Interactive Bot & SRE Group Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=987654321
TELEGRAM_TEAM_GROUP_ID=-1001234567890

# SRE Manager Configuration
SRE_MANAGER_NAME="SRE Lead"
SRE_MANAGER_CLICKUP_ID=1001
SRE_MANAGER_TELEGRAM_CHAT_ID=111111111
SRE_MANAGER_TELEGRAM_TOPIC_ID=0

# SRE Team Members (JSON array of members with their respective Telegram topics)
# Each member has: name, clickup_id, telegram_id (for PV bot interaction), and topic_id (in supergroup)
SRE_TEAM_MEMBERS='[{"name": "Alice Developer", "clickup_id": 1001, "telegram_id": 111111111, "topic_id": 1}, {"name": "Bob Engineer", "clickup_id": 1002, "telegram_id": 222222222, "topic_id": 2}]'

# Decision Engine Mode:
# 'rule_engine' (Default fast, 100% deterministic rule/policy engine - no LLM needed)
# 'ai' (Uses LLM provider below)
# 'hybrid' (Evaluates rules first, falls back to AI)
DECISION_MODE=rule_engine

# AI Provider Configuration (OpenAI-compatible or Anthropic-compatible)
# Supports Local LLM (Ollama, vLLM, local server), OpenAI API, or Anthropic API
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-example-openai-key-here
OPENAI_MODEL=gpt-4o

# Alternatively for Anthropic format:
# AI_PROVIDER=anthropic
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-example-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# App & Database Settings
APP_NAME=Deploy Automation Service
HOST=0.0.0.0
PORT=8085
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/automation.db
